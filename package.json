{
  "name": "vibesquad",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "bin": {
    "vs": "./cli/vs.mjs"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server/serve.mjs",
    "build": "node server/generate-licenses.mjs && tsc --noEmit && vite build && node server/sync-runtime.mjs",
    "build:remote": "vite build --mode remote",
    "build:desktop": "node server/build-desktop.mjs",
    "build:android": "node server/build-android.mjs",
    "release:beta": "node server/release.mjs --channel beta",
    "release:stable": "node server/release.mjs --channel stable",
    "desktop:dev": "tauri dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@getpaseo/client": "0.14.0",
    "@getpaseo/protocol": "0.14.0",
    "@vibesquad/server": "file:server",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
