{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeSquad",
  "version": "0.2.7",
  "identifier": "com.vibesquad.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:remote",
    "frontendDist": "../dist-remote"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VibeSquad",
        "backgroundColor": "#0c0b14"
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": []
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "vibesquad"
          ],
          "host": "pair",
          "appLink": false
        }
      ]
    }
  }
}
