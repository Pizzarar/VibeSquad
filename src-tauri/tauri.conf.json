{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "VibeSquad",
    "mainBinaryName":  "VibeSquad",
    "version":  "0.2.3",
    "identifier":  "com.vibesquad.desktop",
    "build":  {
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "VibeSquad",
                                    "url":  "http://127.0.0.1:4189/",
                                    "width":  1440,
                                    "height":  900,
                                    "minWidth":  420,
                                    "minHeight":  640,
                                    "resizable":  true,
                                    "dragDropEnabled":  false,
                                    "fullscreen":  false,
                                    "backgroundColor":  "#0c0b14"
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: http://127.0.0.1:* http://localhost:* https:; connect-src \u0027self\u0027 http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https: wss:; font-src \u0027self\u0027 data:;"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "createUpdaterArtifacts":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "resources":  [
                                     "runtime"
                                 ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.png",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "installMode":  "currentUser",
                                                "installerHooks":  "nsis/installer-hooks.nsh"
                                            }
                               }
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENDc0OERERTRBRjAyMjUKUldRbEFxL2szVWhIL2ZySlVFQWhVemM3UjU4NUZCcnFkeXhucXhTczFpaE5BUUF3NlRuNk1ZaFMK",
                                    "endpoints":  [
                                                      "https://github.com/Pizzarar/VibeSquad/releases/latest/download/latest.json"
                                                  ]
                                }
                }
}
